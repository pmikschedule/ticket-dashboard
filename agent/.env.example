# ── Supabase ────────────────────────────────────────────────────────────────
# Data API 화면의 Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ 에이전트는 service_role(Secret) 키를 씁니다. 로그인 세션 없이 적재해야 하기 때문입니다.
#    이 키는 RLS 를 우회합니다. 이 파일 밖으로 절대 나가면 안 되고,
#    웹 대시보드나 저장소에는 어떤 형태로도 들어가지 않습니다.
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# 첨부파일 버킷 (schema.sql 이 만듭니다)
SUPABASE_BUCKET=ticket-attachments

# ── Google Gemini (메일 분류) ───────────────────────────────────────────────
# https://aistudio.google.com/apikey 에서 발급합니다.
# 웹 설정 화면(설정 → 시스템 설정)에 등록했다면 **여기는 비워 둬도 됩니다.**
# 두 곳에 다 있으면 설정 화면이 이깁니다 — 화면에서 바꿨는데 .env 가 이기면
# 바꾼 줄 알고 옛 키를 계속 쓰게 됩니다.
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# 분류에 쓸 모델. 어떤 모델을 쓸 수 있는지는 `ticket-agent doctor` 가 알려줍니다.
# 분류는 단순 판별이라 빠르고 싼 모델로 충분합니다.
# 이것도 설정 화면이 우선입니다.
GEMINI_MODEL=gemini-2.5-flash

# 사고(thinking) 토큰 예산. 비워 두면 모델 기본값을 씁니다.
# 0 으로 두면 사고를 끄고 더 싸고 빨라지지만, 모델에 따라 0 을 거부합니다
# (2.5 Pro 등). 비용이 문제되면 0 부터 시험해 보세요.
GEMINI_THINKING_BUDGET=

# ── 메일 백엔드 ─────────────────────────────────────────────────────────────
# outlook  : 운영 (Windows + Outlook 데스크톱)
# fixture  : 개발·테스트 (fixtures/*.json 을 읽고 발송은 파일로 기록)
# auto     : Windows 면 outlook, 그 외에는 fixture (기본값)
AGENT_MAIL_BACKEND=auto

# 스캔할 아웃룩 폴더. 받은편지함 하위 폴더는 '받은 편지함/요청' 처럼 / 로 구분합니다.
OUTLOOK_FOLDER=받은 편지함/요청

# 처리 완료한 메일을 옮길 폴더. 비워 두면 옮기지 않고 읽음 표시만 합니다.
OUTLOOK_DONE_FOLDER=

# ── 수집 범위 ───────────────────────────────────────────────────────────────
# 범위는 **시간**으로 자릅니다. 갯수로 자르면 이미 처리한 메일까지 세어서
# 수집 창이 조용히 좁아집니다 (오래된 신규 메일이 영영 한도 밖에 남습니다).
#
#   첫 기동    — SCAN_SINCE 부터 갯수 제한 없이 전부. 밀린 것을 한 번에 텁니다
#   그다음부터 — 지금부터 SCAN_LOOKBACK_DAYS 일 전까지만
#
# '첫 기동' 판정은 DB(app_settings.last_scan_at)로 합니다. 처음부터 다시 읽게
# 하려면 그 행을 지우세요.

# 첫 기동에서 어디까지 거슬러 올라갈지 (ISO8601). 비우면 폴더 전체.
# 이 선보다 앞의 메일은 영영 보지 않습니다.
SCAN_SINCE=2026-07-01T00:00:00Z

# 두 번째 기동부터 되돌아볼 일수. 넉넉한 편이 낫습니다 —
# 겹쳐 읽은 메일은 중복으로 걸러지지만, 못 읽은 메일은 아무도 모릅니다.
SCAN_LOOKBACK_DAYS=3

# 안전장치입니다. 0 이면 제한 없음(권장).
# 폴더에 수만 통이 있어 첫 기동이 너무 오래 도는 경우에만 켜세요.
SCAN_LIMIT=0

# ── 첨부 ────────────────────────────────────────────────────────────────────
# 서명의 회사 로고·명함 이미지처럼 **본문에 딸려 온** 파일은 자동으로 뺍니다.
# 기준은 Content-ID 가 본문에서 참조되는지, 숨김 표시가 있는지입니다.
# 사용자가 직접 붙인 파일은 그대로 담깁니다. 뺀 것은 티켓 상세에 이름만 남습니다.
#
# 위 기준에 안 걸리는 서명 이미지를 만났을 때만 크기로 마저 거릅니다.
# 이 값(바이트) 미만의 **이미지**만 대상이고, 0 이면 끕니다.
# 근거가 약한 기준입니다 — 요청자가 잘라 붙인 오류 화면도 작을 수 있습니다.
ATTACHMENT_MIN_IMAGE_BYTES=0

# ── 발송 ────────────────────────────────────────────────────────────────────
# display : 아웃룩 창을 띄우고 사람이 확인 후 보냄 (기본값, 권장)
# send    : 즉시 자동 발송
AGENT_SEND_MODE=display

# 발송 큐 폴링 간격(초)
SEND_POLL_INTERVAL=30

# 회신 메일에 참조로 넣을 주소 (쉼표 구분). 비워도 됩니다.
REPLY_CC=

# ── 개발용 ──────────────────────────────────────────────────────────────────
# fixture 백엔드가 읽을 메일 파일
FIXTURE_MAIL_PATH=fixtures/sample_mails.json
# fixture 백엔드가 발송 결과를 기록할 디렉터리
FIXTURE_OUTBOX_DIR=.fixture-outbox

LOG_LEVEL=INFO
