# ---------------------------------------------------------------------------
# desk (Cloudflare Access 뒤에 있습니다)
# ---------------------------------------------------------------------------
DESK_URL=https://desk.saebom.me

# 쿠키를 읽어 올 Chrome 프로필 이름. 비워 두면 전체를 훑어
# 만료가 가장 늦은 쿠키를 고릅니다. (예: "Profile 34")
CHROME_PROFILE=

# 자동 추출이 깨졌을 때의 우회로.
# DevTools → Application → Cookies → desk.saebom.me → CF_Authorization
# 값을 넣으면 자동 추출보다 **이 값이 이깁니다.**
CF_AUTHORIZATION=

# ---------------------------------------------------------------------------
# 티켓 대시보드 (Supabase) — 장애 집계 원천
#
# ⚠️ service_role(Secret) 키를 넣지 마세요. 그 키는 에이전트 PC 의 .env
#    한 곳에만 있어야 합니다. 여기는 Publishable(anon) 키 + 로그인입니다.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://dftqwkvhqjgwrfidsmwc.supabase.co
SUPABASE_ANON_KEY=sb_publishable_jIbBZYbeLOa_IwLO_zhb8Q_J-Zu4-ai
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# ---------------------------------------------------------------------------
# 보고서 머리말·꼬리말
# ---------------------------------------------------------------------------
REPORT_AUTHOR=Steven
REPORT_SUBTITLE=WEB / POVAS 운영·개발
REPORT_TEAM=Compliance Team

# (표 높이는 layout.ts 의 좌표가 정합니다. 행 수를 설정으로 두지 않는 이유는
#  묶음 머리행과 업무 행의 높이가 달라 '몇 행' 이라는 값이 뜻을 잃기 때문입니다.)

# 경로 (reporter/ 기준 상대경로)
SNAPSHOT_DIR=data/snapshots
OUT_DIR=out
