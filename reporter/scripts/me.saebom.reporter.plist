<?xml version="1.0" encoding="UTF-8"?>
<!--
  주기 실행 — 월·화 스캔, 화요일 주간보고, 월 1회 월간보고.

  주간 구간이 화~월 이라 월요일이 끝나야 주가 닫힙니다. 월요일 스캔은 구간
  마감 상태를 담고, 화요일에 그것으로 주간보고를 만듭니다.

  경로가 박혀 있습니다. 저장소를 다른 곳에 두면 아래 세 군데를 고치세요:
    WorkingDirectory · ProgramArguments 의 스크립트 경로 · 로그 경로

  등록:   cp scripts/me.saebom.reporter.plist ~/Library/LaunchAgents/
          launchctl load ~/Library/LaunchAgents/me.saebom.reporter.plist
  해제:   launchctl unload ~/Library/LaunchAgents/me.saebom.reporter.plist
  즉시실행: launchctl start me.saebom.reporter

  ⚠️ 키체인 접근이 필요하므로 **로그인한 사용자 세션**에서 돌아야 합니다.
     LaunchDaemon(시스템 전역)으로 옮기면 쿠키를 못 읽습니다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>me.saebom.reporter</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/Documents/PMS/reporter" &amp;&amp; ./scripts/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/milliontube/Documents/PMS/reporter</string>

  <!-- 월 18:00 스캔(구간 마감) / 화 09:00 스캔+주간보고 / 매월 1일 09:30 월간보고 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>18</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>9</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Day</key><integer>1</integer>
      <key>Hour</key><integer>9</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <!-- 잠들어 있어 놓친 실행은 깨어난 직후 한 번 돌립니다 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/milliontube/Documents/PMS/reporter/data/reporter.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/milliontube/Documents/PMS/reporter/data/reporter.log</string>
</dict>
</plist>
