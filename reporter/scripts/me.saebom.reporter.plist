<?xml version="1.0" encoding="UTF-8"?>
<!--
  주기 실행 — 매월 1일 09:30 월간보고만.

  2026-11-23 부터 desk 수집(월 18:00 · 화 09:00)은 사내 PC 의 에이전트가 합니다.
  이 Mac 은 스캔하지 않고, 월간보고가 대시보드의 스냅샷을 내려받아(`pull`) 만듭니다.
  예전 월·화 스캔 두 줄은 그래서 뺐습니다. 비상시 수집은 손으로 `npm run scan`.
  주간 보고서 자체는 이슈트래커 화면에서 사람이 만듭니다.

  경로가 박혀 있습니다. 저장소를 다른 곳에 두면 아래 세 군데를 고치세요:
    WorkingDirectory · ProgramArguments 의 스크립트 경로 · 로그 경로

  ⚠️ 저장소를 `~/Documents` 밑에 두지 마세요. macOS 가 launchd 로 뜬 프로세스의
     Documents 접근을 막아(TCC) `getcwd: Operation not permitted` 로 죽습니다.
     로그 파일은 launchd 가 직접 열기 때문에 그 에러만 남고 스캔은 한 줄도 안 돕니다.
     `/bin/zsh` 에 전체 디스크 접근 권한을 주면 풀리지만, 홈 바로 밑에 두는 편이
     승인 없이 도는 길입니다.

  등록:   cp scripts/me.saebom.reporter.plist ~/Library/LaunchAgents/
          launchctl load ~/Library/LaunchAgents/me.saebom.reporter.plist
  해제:   launchctl unload ~/Library/LaunchAgents/me.saebom.reporter.plist
  즉시실행: launchctl start me.saebom.reporter

  ⚠️ **로그인한 사용자 세션**(LaunchAgent)에서 돕니다. 월간보고는 desk 쿠키가
     필요 없지만, 비상용 scan 을 다시 붙일 때 키체인을 읽어야 해서 그대로 둡니다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>me.saebom.reporter</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "$HOME/PMS/reporter" &amp;&amp; ./scripts/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/milliontube/PMS/reporter</string>

  <!-- 매월 1일 09:30 월간보고 (스캔은 사내 PC 에이전트가 합니다) -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Day</key><integer>1</integer>
      <key>Hour</key><integer>9</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <!-- 잠들어 있어 놓친 실행은 깨어난 직후 한 번 돌립니다 -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/milliontube/PMS/reporter/data/reporter.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/milliontube/PMS/reporter/data/reporter.log</string>
</dict>
</plist>
